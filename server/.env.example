# ---- Server ----
PORT=4000
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-string

# Public base URL where your frontend is served.
# Used to build the magic-link and password-reset links in emails.
# Local dev:   http://localhost:8000
# GitHub Pages: https://gtawefuck.github.io/anim
FRONTEND_URL=http://localhost:8000

# CORS origin allowed to call this API (use * for quick testing).
CORS_ORIGIN=*

# ---- SMTP email (Gmail example) ----
# Leave SMTP_HOST blank to auto-use a free Ethereal dev inbox (preview links in console).
# Gmail: create an App Password (Google Account > Security > App passwords) and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password
FROM_EMAIL=SoulScythe <your@gmail.com>
